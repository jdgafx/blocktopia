# Local development: npm run play configures the local backend automatically.
# Public hosting: set these in Netlify environment variables before deploying.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional TURN relay for players behind restrictive NATs.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
